{
  "name": "@matchx/docapp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "test:spec": "playwright test --grep '@feat|@seokit|@analytics'",
    "test:spec:analytics": "playwright test --grep @analytics",
    "test:spec:cov": "E2E_COVERAGE=true npm run test:spec",
    "test:spec:feat": "playwright test --grep @feat",
    "test:spec:perf": "playwright test --grep @perf",
    "test:spec:seokit": "playwright test --grep @seokit",
    "test:spec:visual": "playwright test --grep @visual",
    "test:type": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@sargonpiraev/matchx": "*",
    "fumadocs-core": "^16.10.5",
    "fumadocs-mdx": "^15.0.12",
    "fumadocs-typescript": "^5.2.6",
    "fumadocs-ui": "^16.10.5",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sargonpiraev/seokit": "^0.9.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.13.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "nextcov": "^1.5.1",
    "tailwindcss": "^4.1.7",
    "typescript": "5.9.2"
  }
}
