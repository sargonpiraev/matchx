{
  "$schema": "./node_modules/@sargonpiraev/eslint-config/build/schemas/project__package.json",
  "name": "matchx",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "npm run test:type",
    "commitlint": "commitlint --edit",
    "dev": "turbo run dev",
    "lint": "npm run test:codestyles",
    "prepare": "lefthook install",
    "pulumi:preview": "npm --prefix pulumi run preview",
    "pulumi:up": "npm --prefix pulumi run up",
    "test": "npm run test:unit && npm run test:pulumi",
    "test:alint": "alint check",
    "test:analytics": "npm run test:analytics -w @matchx/docapp",
    "test:check-types": "npm run test:type",
    "test:codestyles": "turbo run test:codestyles",
    "test:cwv": "npm run test:cwv -w @matchx/docapp",
    "test:eslint": "npm run lint",
    "test:format": "prettier --check \"**/*.{ts,tsx,md}\"",
    "test:functional": "npm run test:functional -w @matchx/docapp",
    "test:seo": "npm run test:seo -w @matchx/docapp",
    "test:spec": "npm run test:spec -w @matchx/docapp",
    "test:type": "turbo run test:type",
    "test:unit": "turbo run test:unit",
    "test:visual": "npm run test:visual -w @matchx/docapp",
    "test:pulumi": "npm ci --prefix pulumi && npm --prefix pulumi run test:pulumi"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "12.0.1"
    },
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "next": {
      "postcss": "8.5.10"
    },
    "postcss": "8.5.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@asamarts/alint": "^0.14.2",
    "@commitlint/cli": "21.2.2",
    "@sargonpiraev/commitlint-config": "1.2.0",
    "@sargonpiraev/eslint-config": "1.9.0",
    "@sargonpiraev/prettier-config": "1.3.0",
    "@sargonpiraev/semantic-release-config": "1.3.0",
    "@sargonpiraev/tsconfig": "1.2.0",
    "@semantic-release/github": "^12.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "semantic-release": "^25.0.8",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@asamarts/alint@0.14.2": true
  }
}
