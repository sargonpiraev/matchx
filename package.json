{
  "$schema": "./node_modules/@sargonpiraev/eslint-config/build/schemas/project__package.json",
  "name": "matchx",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "npm run test:type",
    "commitlint": "commitlint --edit",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{mjs,cjs,js,ts,tsx,md,json,yaml,yml}\"",
    "lint": "npm run test:codestyles",
    "npm:install": "npm install",
    "prepare": "lefthook install",
    "pulumi:preview": "npm --prefix pulumi run preview",
    "pulumi:up": "npm --prefix pulumi run up",
    "test": "npm run test:unit && npm run test:pulumi",
    "test:build": "npm run build",
    "test:check-types": "turbo run check-types",
    "test:codestyles": "turbo run test:codestyles",
    "test:configlint": "alint check -c .alint.configlint.yaml",
    "test:eslint": "eslint .",
    "test:format": "prettier --check \"**/*.{mjs,cjs,js,ts,tsx,md,json,yaml,yml}\"",
    "test:fslint": "alint check -c .alint.fslint.yaml",
    "test:pulumi": "npm ci --prefix pulumi --ignore-scripts && npm --prefix pulumi run test:pulumi",
    "test:spec": "npm run test:spec -w @matchx/docapp",
    "test:spec:analytics": "npm run test:spec:analytics -w @matchx/docapp",
    "test:spec:feat": "npm run test:spec:feat -w @matchx/docapp",
    "test:spec:perf": "npm run test:spec:perf -w @matchx/docapp",
    "test:spec:seokit": "npm run test:spec:seokit -w @matchx/docapp",
    "test:spec:visual": "bash scripts/pw-visual-docker.sh",
    "test:spec:visual:update": "bash scripts/pw-visual-docker.sh --update-snapshots",
    "test:type": "turbo run test:type",
    "test:unit": "turbo run test:unit"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "12.0.1"
    },
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "next": {
      "postcss": "8.5.10"
    },
    "postcss": "8.5.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@asamarts/alint": "^0.15.2",
    "@commitlint/cli": "21.2.2",
    "@sargonpiraev/commitlint-config": "1.4.0",
    "@sargonpiraev/configlint-config": "1.2.0",
    "@sargonpiraev/eslint-config": "1.15.0",
    "@sargonpiraev/fslint-config": "1.1.0",
    "@sargonpiraev/lefthook-config": "0.0.1",
    "@sargonpiraev/prettier-config": "1.3.0",
    "@sargonpiraev/semantic-release-config": "1.3.0",
    "@sargonpiraev/tsconfig": "1.3.0",
    "@semantic-release/github": "^12.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "semantic-release": "^25.0.8",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@asamarts/alint@0.15.2": true
  }
}
