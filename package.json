{
  "name": "matchx",
  "private": true,
  "packageManager": "npm@10.9.4",
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "postcss": "8.5.10",
    "next": {
      "postcss": "8.5.10"
    },
    "@semantic-release/npm": {
      "npm": "12.0.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "npm run test:codestyles",
    "check-types": "npm run test:type",
    "test": "npm run test:unit",
    "test:unit": "turbo run test:unit",
    "test:type": "turbo run test:type",
    "test:codestyles": "turbo run test:codestyles",
    "prepare": "lefthook install",
    "commitlint": "commitlint --edit",
    "test:lint": "npm run lint",
    "test:check-types": "npm run test:type",
    "test:functional": "npm run test:functional -w @matchx/docapp",
    "test:seo": "npm run test:seo -w @matchx/docapp",
    "test:analytics": "npm run test:analytics -w @matchx/docapp",
    "test:spec": "npm run test:spec -w @matchx/docapp",
    "test:visual": "npm run test:visual -w @matchx/docapp",
    "test:cwv": "npm run test:cwv -w @matchx/docapp",
    "test:format": "prettier --check \"**/*.{ts,tsx,md}\"",
    "test:alint": "alint check"
  },
  "devDependencies": {
    "@asamarts/alint": "^0.14.2",
    "@commitlint/cli": "^19.8.0",
    "@sargonpiraev/commitlint-config": "^1.0.0",
    "@sargonpiraev/eslint-config": "^1.4.0",
    "@sargonpiraev/prettier-config": "^1.0.0",
    "@sargonpiraev/tsconfig": "^1.0.0",
    "@semantic-release/github": "^12.0.6",
    "eslint": "^9.26.0",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "turbo": "^2.9.18",
    "typescript": "^5.8.2"
  },
  "$schema": "../schema/project__package.json",
  "allowScripts": {
    "@asamarts/alint@0.14.2": true
  }
}
